{
  "name": "scout-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Scout App",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "lint:fix": "eslint --ext .js,.ts . --fix",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "deploy:rovers": "firebase deploy --only functions:createRover,functions:updateRover,functions:deleteRover,functions:approveRover,functions:rejectRover",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@types/sharp": "^0.31.1",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.5.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.29.1",
    "typescript": "^5.3.3"
  },
  "private": true
}
